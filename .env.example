# ============================================================
# Cuspid — environment configuration TEMPLATE
#
# This file IS committed and must contain no real secrets.
# Copy it to `.env` and fill in real values there:
#
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# `.env` is gitignored. Never commit it.
#
# WARNING: none of these values may be read by the browser.
# The prototype in prototype/ is static HTML/JS — anything it
# loads is visible to every visitor. Secrets belong only in
# build scripts, CI, or a future backend.
# ============================================================

# ── GitHub ────────────────────────────────────────────────
# Classic personal access token (ghp_…) or fine-grained token
# (github_pat_…). Used for repo automation / CI only.
# Create at: https://github.com/settings/tokens
# Scope it as narrowly as the task allows — for a private repo,
# `repo` alone is usually enough. Do not grant `admin:*`.
GITHUB_TOKEN=

# Optional: default repo for scripts, as owner/name
GITHUB_REPO=

# ── App ───────────────────────────────────────────────────
# development | staging | production
APP_ENV=development
APP_PORT=8000

# ── Backend (not yet chosen — see CLAUDE.md) ──────────────
# Fill these in once a stack is picked.
DATABASE_URL=
SESSION_SECRET=

# ── License-verification registries (future) ──────────────
# Contributor verification will need one registry integration
# per launch region. Left blank until a region is chosen.
NPI_REGISTRY_API_KEY=
DCI_REGISTRY_API_KEY=
