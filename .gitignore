# ── Secrets ───────────────────────────────────────────────
# Never commit real credentials. Only .env.example is tracked.
.env
.env.*
!.env.example
*.pem
*.key

# Legacy/stray secret files
config
prototype/config
secrets.*

# ── Dependencies & build output ───────────────────────────
node_modules/
dist/
build/
.cache/

# ── Editor / OS ───────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────
*.log
npm-debug.log*

# ── Local credentials & database ──────────────────────────
# ACCOUNTS.txt holds the seeded dev passwords in plain text.
ACCOUNTS.txt
*.db
*.db-wal
*.db-shm
server/dental_info.db*

# server logs from local runs
server_test.log
strict.log

# Python
__pycache__/
*.py[cod]
